{
  "name": "clawscad",
  "version": "0.1.0",
  "description": "AI-powered 3D CAD — OpenSCAD + Claude Code with checkpoint branching",
  "main": "main.js",
  "scripts": {
    "build": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && esbuild renderer.js --bundle --outfile=dist/renderer.js --format=esm --platform=browser --loader:.ttf=file && esbuild mcp/server.js --bundle --outfile=dist/mcp-server.js --format=cjs --platform=node",
    "download-openscad": "node scripts/download-openscad.js && node scripts/download-libs.js",
    "start": "npm run build && electron . --no-sandbox",
    "dev": "npm run build && electron . --dev --no-sandbox",
    "test:backend": "node --test tests/backend-reliability.js",
    "test:mcp": "node --test tests/mcp-server.js",
    "test": "node scripts/check-native-deps.js && npm run test:backend && npm run test:mcp && node tests/download-openscad.js && npm run build && npx playwright test",
    "test:headed": "npm run build && npx playwright test --headed",
    "pack": "npm run download-openscad && npm run build && electron-builder --dir",
    "dist": "npm run download-openscad && npm run build && electron-builder",
    "dist:linux": "npm run download-openscad && npm run build && electron-builder --linux",
    "dist:win": "npm run download-openscad && npm run build && electron-builder --win",
    "dist:mac": "npm run download-openscad && npm run build && electron-builder --mac"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "chokidar": "^3.6.0",
    "monaco-editor": "^0.55.1",
    "node-pty": "^1.0.0",
    "three": "^0.170.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "electron-playwright-helpers": "^2.1.0",
    "esbuild": "^0.28.0"
  },
  "overrides": {
    "dompurify": "^3.4.5"
  },
  "build": {
    "appId": "com.clawscad.app",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "productName": "ClawSCAD",
    "artifactName": "${productName}-${version}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "mcp/geometry.js",
      "index.html",
      "style.css",
      "icon.png",
      "dist/**/*",
      "node_modules/**/*",
      "!node_modules/.cache"
    ],
    "extraResources": [
      {
        "from": "icon.png",
        "to": "icon.png"
      }
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png",
      "category": "Graphics",
      "extraResources": [
        { "from": "vendors/openscad-linux.AppImage", "to": "openscad-linux.AppImage" },
        { "from": "vendors/libs", "to": "libs" }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png",
      "extraResources": [
        { "from": "vendors/openscad-win", "to": "openscad-win" },
        { "from": "vendors/libs", "to": "libs" }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "icon.png",
      "category": "public.app-category.graphics-design",
      "extraResources": [
        { "from": "vendors/OpenSCAD.app", "to": "OpenSCAD.app" },
        { "from": "vendors/libs", "to": "libs" }
      ]
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "license": "MIT"
}
